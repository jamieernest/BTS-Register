# Copy to .env (never commit it). `npm start` loads it automatically.
NODE_ENV=production
PORT=3000
# Public https URL users see (used for the CAS service URL and Keycloak redirect URI). No trailing slash.
PUBLIC_URL=https://register.example.com
# Random string, 16+ chars, signs session cookies. e.g. `openssl rand -hex 32`
SESSION_SECRET=
# SQLite file
DB_PATH=./data/register.db
# IANA time zone that decides "today is a show day"
TIMEZONE=Europe/London
# Set to false only for plain-http local testing (cookies are Secure by default)
COOKIE_SECURE=true

# Cast login (CAS)
CAS_URL=https://auth.bath.ac.uk

# Marshal login (Keycloak; same server as BTS-Dress-Notes, but create a client for this app)
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/your-realm
KEYCLOAK_CLIENT_ID=bts-register
KEYCLOAK_CLIENT_SECRET=

# LDAP username check at cast import (anonymous bind). These are the defaults for ldap.bath.ac.uk.
LDAP_URL=ldap://ldap.bath.ac.uk
LDAP_BASE_DN=o=bath.ac.uk
LDAP_USER_ATTRIBUTE=uid
LDAP_NAME_ATTRIBUTE=displayName

# Optional: trust an X-User header (Traefik forwardAuth) as the cast identity. OFF by default.
# Only enable if the app is reachable exclusively through that proxy, which sets/overwrites the header.
TRUST_X_USER_HEADER=false

# Local development only. The app refuses to start if this is true and NODE_ENV=production.
# In dev mode LDAP is skipped unless LDAP_URL is set, and /dev/login?user=twjk20[&role=marshal] is available.
DEV_MODE=false
